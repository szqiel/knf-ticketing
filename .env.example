# Supabase Database Connection
# 1. DATABASE_URL: Use Supavisor Transaction Pooler (port 6543) for runtime API/lambdas
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

# 2. DIRECT_URL: Use Supavisor Session Pooler (port 5432) or Direct Connection for Drizzle migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Master Booking Toggle (default false on initial seed)
SEED_BOOKING_OPEN=false

# Admin Operational Panel Auth
ADMIN_PASSWORD="[CHANGE-ME-SECURE-PASSWORD]"
ADMIN_SESSION_SECRET="[CHANGE-ME-RANDOM-HEX-32-CHARS]"

# Production Public App URL (used for QR codes & tickets)
NEXT_PUBLIC_APP_URL="https://[YOUR-APP].vercel.app"

# Supabase Storage for Film Poster Uploads (Public Bucket: knf-media)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
SUPABASE_STORAGE_BUCKET="knf-media"
